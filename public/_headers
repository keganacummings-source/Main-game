# Cloudflare Workers Static Assets headers (copied to dist-static by Vite).
# Note: when several rules match, Cloudflare merges them, so Cache-Control is
# only set in the specific rules below, never in /*.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# HTML entry: always revalidate so a deploy is picked up immediately.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Vite output is content-hashed -> safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Stable filenames, rarely change -> cache for a day.
/MapAssets/*
  Cache-Control: public, max-age=86400
/sprites/*
  Cache-Control: public, max-age=86400
/beasts/*
  Cache-Control: public, max-age=86400
